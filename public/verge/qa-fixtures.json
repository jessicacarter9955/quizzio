  "lessons": {
    "lessons": [
      {
        "id": 1,
        "title": "Welcome to the Markets",
        "category": "Getting Started",
        "description": "Learn what drives markets and how paper trading works.",
        "content": "A stock is a share in a company. Markets match buyers and sellers. Paper trading lets you practice with virtual money and no real brokerage account.",
        "level": "Beginner",
        "duration_minutes": 8,
        "sort_order": 1
      },
      {
        "id": 2,
        "title": "Understanding Candlesticks",
        "category": "Technical Analysis",
        "description": "Learn what candles represent.",
        "content": "A candlestick encodes open, high, low, close prices within one period. Wicks show the extremes; neither candlesticks nor indicators guarantee future prices.",
        "level": "Beginner",
        "duration_minutes": 12,
        "sort_order": 2
      },
      {
        "id": 3,
        "title": "Risk & Position Sizing",
        "category": "Risk Management",
        "description": "Practice diversification and appropriate risk budgets.",
        "content": "Diversification can reduce concentration. Decide how much of your virtual capital to risk and record an invalidation level for each trade.",
        "level": "Core",
        "duration_minutes": 15,
        "sort_order": 3
      },
      {
        "id": 4,
        "title": "Market vs Limit Orders",
        "category": "Trading Mechanics",
        "description": "Understand real versus simulated orders.",
        "content": "Real market orders may slip and incur fees. Virtual orders here fill at a reference quote, without commissions or spreads.",
        "level": "Core",
        "duration_minutes": 10,
        "sort_order": 4
      },
      {
        "id": 5,
        "title": "Build a Trading Journal",
        "category": "Trading Psychology",
        "description": "Reflect on every virtual trade.",
        "content": "Write your plan, risk, reasoning and outcomes. Review decisions independently of lucky short-term returns.",
        "level": "Beginner",
        "duration_minutes": 11,
        "sort_order": 5
      },
      {
        "id": 6,
        "title": "Reviewing Performance",
        "category": "Portfolio Skills",
        "description": "Understand cash, holdings and P&L.",
        "content": "Portfolio equity equals cash plus the reference value of open positions. Unrealized gains are not realized until a sale.",
        "level": "Core",
        "duration_minutes": 9,
        "sort_order": 6
      }
    ]
  }
